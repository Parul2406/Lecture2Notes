# Copy to .env and adjust. All values are optional.
DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=change-me
SECURE_COOKIES=false
MAX_UPLOAD_MB=2048

# Path to ffmpeg; leave empty to use PATH, then the bundled imageio-ffmpeg binary
FFMPEG_BINARY=

# Whisper (faster-whisper): tiny, base, small, medium, large-v3, distil-large-v3 ...
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5
WHISPER_WORD_TIMESTAMPS=true
