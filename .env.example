# Copy to .env and adjust. All values are optional.
DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=change-me
SECURE_COOKIES=false
MAX_UPLOAD_MB=2048
# Longest video that can be imported from a link (YouTube etc.)
MAX_DOWNLOAD_HOURS=4

# Address students use to open share links, e.g. http://192.168.1.20:8000 (empty = same as the teacher's browser).
# For students on other devices, run the server with --host 0.0.0.0.
PUBLIC_BASE_URL=

# Path to ffmpeg; leave empty to use PATH, then the bundled imageio-ffmpeg binary
FFMPEG_BINARY=

# Whisper (faster-whisper): tiny, base, small, medium, large-v3, distil-large-v3 ...
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5
WHISPER_WORD_TIMESTAMPS=true

# Notes generation (summary, key points, definitions, MCQs) with a local model via Ollama.
# Runs on this machine; nothing is sent to the internet. Install Ollama, then: ollama pull gemma4
NOTES_ENABLED=true
NOTES_AUTO=true
OLLAMA_URL=http://127.0.0.1:11434
NOTES_MODEL=gemma4
NOTES_CHUNK_WORDS=1500
NOTES_NUM_CTX=8192
NOTES_TIMEOUT=900

# PDF export: path to a Unicode .ttf font (empty = auto-detect Arial/DejaVu)
PDF_FONT=
